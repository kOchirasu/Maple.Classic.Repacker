<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
        Two builds of the same backend:
          net10.0-windows : WinExe with the native Windows Forms + WebView2 desktop shell (WindowsDesktopShell.cs).
          net10.0         : cross-platform headless backend, hosted by the Electron shell (electron/) on Linux/macOS
                            or opened directly in a browser in headless mode.
        The WINDOWS symbol is only defined for net10.0-windows, so #if WINDOWS code is excluded elsewhere.
    -->
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
        <OutputType>Exe</OutputType>
        <SelfContained>false</SelfContained>
        <DebugType Condition="$(Configuration.StartsWith('Release'))">none</DebugType>
        <DebugSymbols Condition="$(Configuration.StartsWith('Release'))">false</DebugSymbols>
        <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
        <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
        <FrontendOutDir>$(MSBuildProjectDirectory)/obj/ts/</FrontendOutDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <OutputType>WinExe</OutputType>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <UseWindowsForms>true</UseWindowsForms>
        <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
        <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <!-- Cross-platform publishes (e.g. -r linux-x64 / osx-arm64 for the Electron bundle) are single-file when a RID is given. -->
    <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0' and '$(RuntimeIdentifier)' != ''">
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MessagePack" Version="3.1.12" />
        <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.1" PrivateAssets="all" GeneratePathProperty="true" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" GeneratePathProperty="true" />
        <PackageReference Include="Fody" Version="6.9.3" PrivateAssets="all" />
        <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
        <Compile Remove="WindowsDesktopShell.cs" />
        <None Include="WindowsDesktopShell.cs" />
    </ItemGroup>

    <Target Name="ConfigureWebView2ForCostura" BeforeTargets="ResolveAssemblyReferences;FodyTarget" Condition="'$(TargetFramework)' == 'net10.0-windows'">
        <ItemGroup>
            <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
            <ReferenceCopyLocalPaths Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')">
                <DestinationSubDirectory>runtimes\win-x64\native\</DestinationSubDirectory>
            </ReferenceCopyLocalPaths>
        </ItemGroup>
    </Target>

    <Target Name="ResolveNodeExecutable">
        <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
            <_RegMachinePath>$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\Session Manager\Environment', 'Path', '', RegistryView.Registry64))</_RegMachinePath>
            <_RegUserPath>$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\Environment', 'Path', '', RegistryView.Registry64))</_RegUserPath>
        </PropertyGroup>
        <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
            <_PathDir Include="$([System.String]::Copy('$(PATH);$(_RegUserPath);$(_RegMachinePath)').Replace('&quot;', '').Split(';', System.StringSplitOptions.RemoveEmptyEntries))" />
            <_NodeCandidate Include="%(_PathDir.Identity)\node.exe" Condition="Exists('%(_PathDir.Identity)\node.exe')" />
            <_NodeCandidate Include="$(ProgramW6432)\nodejs\node.exe" Condition="'$(ProgramW6432)' != '' and Exists('$(ProgramW6432)\nodejs\node.exe')" />
            <_NodeCandidate Include="$(ProgramFiles)\nodejs\node.exe" Condition="'$(ProgramFiles)' != '' and Exists('$(ProgramFiles)\nodejs\node.exe')" />
            <_NodeCandidate Include="$(LocalAppData)\Programs\nodejs\node.exe" Condition="'$(LocalAppData)' != '' and Exists('$(LocalAppData)\Programs\nodejs\node.exe')" />
            <_NodeCandidate Include="$(NVM_SYMLINK)\node.exe" Condition="'$(NVM_SYMLINK)' != '' and Exists('$(NVM_SYMLINK)\node.exe')" />
            <_NodeCandidate Include="$(Volta_Home)\bin\node.exe" Condition="'$(Volta_Home)' != '' and Exists('$(Volta_Home)\bin\node.exe')" />
            <_NodeCandidate Include="$(LocalAppData)\Volta\bin\node.exe" Condition="'$(LocalAppData)' != '' and Exists('$(LocalAppData)\Volta\bin\node.exe')" />
            <_NodeCandidate Include="$(LocalAppData)\Microsoft\WinGet\Links\node.exe" Condition="'$(LocalAppData)' != '' and Exists('$(LocalAppData)\Microsoft\WinGet\Links\node.exe')" />
            <_NodeCandidate Include="$(LocalAppData)\Microsoft\WinGet\Packages\*NodeJS*\*\node.exe" Condition="'$(LocalAppData)' != ''" />
            <_NodeCandidate Include="$(AppData)\fnm\aliases\default\node.exe" Condition="'$(AppData)' != '' and Exists('$(AppData)\fnm\aliases\default\node.exe')" />
            <_NodeCandidate Include="$(LocalAppData)\fnm\aliases\default\node.exe" Condition="'$(LocalAppData)' != '' and Exists('$(LocalAppData)\fnm\aliases\default\node.exe')" />
            <_NodeCandidate Include="$(UserProfile)\.fnm\aliases\default\node.exe" Condition="'$(UserProfile)' != '' and Exists('$(UserProfile)\.fnm\aliases\default\node.exe')" />
            <_NodeCandidate Include="$(UserProfile)\.local\share\fnm\aliases\default\node.exe" Condition="'$(UserProfile)' != '' and Exists('$(UserProfile)\.local\share\fnm\aliases\default\node.exe')" />
            <_NodeCandidate Include="$(AppData)\fnm\node-versions\*\installation\node.exe" Condition="'$(AppData)' != ''" />
            <_NodeCandidate Include="$(LocalAppData)\fnm\node-versions\*\installation\node.exe" Condition="'$(LocalAppData)' != ''" />
            <_NodeCandidate Include="$(UserProfile)\.fnm\node-versions\*\installation\node.exe" Condition="'$(UserProfile)' != ''" />
            <_NodeCandidate Include="$(UserProfile)\.local\share\fnm\node-versions\*\installation\node.exe" Condition="'$(UserProfile)' != ''" />
            <_NodeCandidate Include="$(AppData)\nvm\*\node.exe" Condition="'$(AppData)' != ''" />
            <_NodeCandidate Include="$(LocalAppData)\nvm\*\node.exe" Condition="'$(LocalAppData)' != ''" />
            <_NodeCandidate Include="$(NVM_HOME)\*\node.exe" Condition="'$(NVM_HOME)' != ''" />
            <_NodeCandidate Include="$(UserProfile)\scoop\shims\node.exe" Condition="'$(UserProfile)' != '' and Exists('$(UserProfile)\scoop\shims\node.exe')" />
            <_NodeCandidate Include="$(UserProfile)\scoop\apps\nodejs*\current\node.exe" Condition="'$(UserProfile)' != ''" />
            <_NodeCandidate Include="$(ProgramData)\chocolatey\bin\node.exe" Condition="'$(ProgramData)' != '' and Exists('$(ProgramData)\chocolatey\bin\node.exe')" />
            <_NodeCandidate Include="$(MSBuildProgramFiles32)\nodejs\node.exe" Condition="'$(MSBuildProgramFiles32)' != '' and Exists('$(MSBuildProgramFiles32)\nodejs\node.exe')" />
            <_NodeCandidate Include="C:\Program Files\Microsoft Visual Studio\*\*\MSBuild\Microsoft\VisualStudio\NodeJs\node.exe" />
        </ItemGroup>
        <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
            <_PathDir Include="$([System.String]::Copy('$(PATH)').Replace('&quot;', '').Split(':', System.StringSplitOptions.RemoveEmptyEntries))" />
            <_NodeCandidate Include="%(_PathDir.Identity)/node" Condition="Exists('%(_PathDir.Identity)/node')" />
            <_NodeCandidate Include="/usr/local/bin/node" Condition="Exists('/usr/local/bin/node')" />
            <_NodeCandidate Include="/opt/homebrew/bin/node" Condition="Exists('/opt/homebrew/bin/node')" />
            <_NodeCandidate Include="/usr/bin/node" Condition="Exists('/usr/bin/node')" />
            <_NodeCandidate Include="$(HOME)/.volta/bin/node" Condition="'$(HOME)' != '' and Exists('$(HOME)/.volta/bin/node')" />
            <_NodeCandidate Include="$(HOME)/.asdf/shims/node" Condition="'$(HOME)' != '' and Exists('$(HOME)/.asdf/shims/node')" />
            <_NodeCandidate Include="$(HOME)/.local/share/mise/shims/node" Condition="'$(HOME)' != '' and Exists('$(HOME)/.local/share/mise/shims/node')" />
            <_NodeCandidate Include="$(HOME)/.fnm/aliases/default/bin/node" Condition="'$(HOME)' != '' and Exists('$(HOME)/.fnm/aliases/default/bin/node')" />
            <_NodeCandidate Include="$(HOME)/.local/share/fnm/aliases/default/bin/node" Condition="'$(HOME)' != '' and Exists('$(HOME)/.local/share/fnm/aliases/default/bin/node')" />
            <_NodeCandidate Include="$(HOME)/.fnm/node-versions/*/installation/bin/node" Condition="'$(HOME)' != ''" />
            <_NodeCandidate Include="$(HOME)/.local/share/fnm/node-versions/*/installation/bin/node" Condition="'$(HOME)' != ''" />
            <_NodeCandidate Include="$(HOME)/.nvm/versions/node/*/bin/node" Condition="'$(HOME)' != ''" />
        </ItemGroup>
        <PropertyGroup>
            <NodeExe Condition="'$(NodeExe)' == '' and Exists('%(_NodeCandidate.Identity)')">%(_NodeCandidate.Identity)</NodeExe>
            <NodeExe Condition="'$(NodeExe)' == ''">node</NodeExe>
            <NodeDir Condition="Exists('$(NodeExe)')">$([System.IO.Path]::GetDirectoryName('$(NodeExe)'))</NodeDir>
            <NpmCmd Condition="'$(OS)' == 'Windows_NT' and '$(NodeDir)' != '' and Exists('$(NodeDir)\npm.cmd')">set "PATH=$(NodeDir);%PATH%" &amp;&amp; "$(NodeDir)\npm.cmd"</NpmCmd>
            <NpmCmd Condition="'$(OS)' != 'Windows_NT' and '$(NodeDir)' != '' and Exists('$(NodeDir)/npm')">PATH="$(NodeDir):$PATH" "$(NodeDir)/npm"</NpmCmd>
            <NpmCmd Condition="'$(NpmCmd)' == ''">npm</NpmCmd>
        </PropertyGroup>
    </Target>

    <!--
        Frontend build (npm install, CodeMirror/msgpack vendor bundles, tsc) writes to obj/ts/ and is shared by both
        target frameworks. It is incremental, and the multi-target outer build runs it once up front, so the parallel
        per-framework inner builds see up-to-date outputs and skip it instead of racing on the same files.
    -->
    <ItemGroup>
        <FrontendInput Include="wwwroot/**/*.ts;scripts/**/*;package.json;tsconfig.json" />
        <FrontendOutput Include="$(FrontendOutDir)wwwroot/app.js;$(FrontendOutDir)wwwroot/rpc.js;$(FrontendOutDir)wwwroot/layout.js;$(FrontendOutDir)wwwroot/vendor/codemirror/cm6.bundle.js;$(FrontendOutDir)wwwroot/vendor/msgpack/msgpack.min.js" />
    </ItemGroup>

    <Target Name="BuildFrontend" DependsOnTargets="ResolveNodeExecutable" Inputs="@(FrontendInput)" Outputs="@(FrontendOutput)">
        <Exec Condition="!Exists('$(MSBuildProjectDirectory)/node_modules/@codemirror/view') or !Exists('$(MSBuildProjectDirectory)/node_modules/@codemirror/lang-json') or !Exists('$(MSBuildProjectDirectory)/node_modules/typescript/lib/tsc.js') or !Exists('$(MSBuildProjectDirectory)/node_modules/@msgpack/msgpack') or ('$(OS)' == 'Windows_NT' and !Exists('$(MSBuildProjectDirectory)/node_modules/@esbuild/win32-x64')) or ('$(OS)' != 'Windows_NT' and !Exists('$(MSBuildProjectDirectory)/node_modules/@esbuild/linux-x64') and !Exists('$(MSBuildProjectDirectory)/node_modules/@esbuild/darwin-arm64') and !Exists('$(MSBuildProjectDirectory)/node_modules/@esbuild/darwin-x64'))" Command="$(NpmCmd) install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)" />
        <Exec Command="&quot;$(NodeExe)&quot; &quot;$(MSBuildProjectDirectory)/scripts/build-vendor.mjs&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" />
        <PropertyGroup>
            <TscJs Condition="Exists('$(MSBuildProjectDirectory)/node_modules/typescript/lib/tsc.js')">$(MSBuildProjectDirectory)/node_modules/typescript/lib/tsc.js</TscJs>
            <TscJs Condition="'$(TscJs)' == '' and Exists('$(PkgMicrosoft_TypeScript_MSBuild)/tools/tsc/tsc.js')">$(PkgMicrosoft_TypeScript_MSBuild)/tools/tsc/tsc.js</TscJs>
        </PropertyGroup>
        <Error Condition="'$(TscJs)' == ''" Text="TypeScript compiler not found. Run 'npm install' in $(MSBuildProjectDirectory)." />
        <Exec Command="&quot;$(NodeExe)&quot; &quot;$(TscJs)&quot; -p &quot;$(MSBuildProjectDirectory)/tsconfig.json&quot;" />
    </Target>

    <Target Name="BuildFrontendBeforeInnerBuilds" BeforeTargets="DispatchToInnerBuilds" DependsOnTargets="BuildFrontend" />

    <Target Name="EmbedFrontend" DependsOnTargets="BuildFrontend" BeforeTargets="SplitResourcesByCulture;CoreCompile">
        <ItemGroup>
            <!-- Compiled TypeScript (rpc.js, layout.js, app.js, app/*.js) plus the vendor bundles, keeping their wwwroot-relative paths -->
            <FrontendJs Include="obj/ts/wwwroot/**/*.js" />
            <EmbeddedResource Include="@(FrontendJs)" LogicalName="wwwroot/$([System.String]::Copy('%(FrontendJs.RecursiveDir)').Replace('\', '/'))%(FrontendJs.Filename)%(FrontendJs.Extension)" />
        </ItemGroup>
        <Copy SourceFiles="@(FrontendJs)" DestinationFiles="@(FrontendJs->'$(OutputPath)wwwroot/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Maple.Classic.Repacker.Engine\Maple.Classic.Repacker.Engine.csproj" />
        <ProjectReference Include="..\Maple.Classic.File\Maple.Classic.File.IO\Maple.Classic.File.IO.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="electron\**" />
        <None Remove="electron\**" />
        <Content Remove="node_modules\**" />
        <None Remove="node_modules\**" />
        <Content Remove="scripts\**" />
        <None Remove="scripts\**" />
        <Content Remove="package.json;package-lock.json;tsconfig.json" />
        <None Include="package.json;tsconfig.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
        <Content Remove="wwwroot\**\*.ts" />
        <None Include="wwwroot\**\*.ts" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
        <UpToDateCheckInput Include="wwwroot\**\*;scripts\**\*;package.json;tsconfig.json" />
        <UpToDateCheckBuilt Include="$(OutputPath)wwwroot\app.js" Original="wwwroot\app.ts" />
        <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
        <EmbeddedResource Include="wwwroot\**" Exclude="wwwroot\**\*.ts" LogicalName="wwwroot/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="StripPublishWebAssets" AfterTargets="ComputeResolvedFilesToPublishList">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('wwwroot')) or $([System.String]::Copy('%(RelativePath)').EndsWith('.staticwebassets.endpoints.json'))" />
        </ItemGroup>
    </Target>

    <Target Name="CleanPublishEndpointsJson" AfterTargets="Publish">
        <Delete Files="$(PublishDir)$(AssemblyName).staticwebassets.endpoints.json" />
    </Target>

</Project>
