{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "outDir": "./obj/ts",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false
  },
  "files": [
    "wwwroot/rpc.ts",
    "wwwroot/layout.ts",
    "wwwroot/app.ts",
    "electron/main.ts"
  ]
}
